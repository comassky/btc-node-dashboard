{
  "name": "bitcoin-node-dashboard",
  "version": "1.6.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc --noEmit && vite build --minify esbuild",
    "preview": "vite preview",
    "serve": "sirv dist --single --cors --port 4173",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "ci:build": "npm ci && vue-tsc --noEmit && vite build --minify esbuild",
    "update-docs": "node ../../../update-docs.mjs"
  },
  "dependencies": {
    "@floating-ui/vue": "2.0.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/motion": "3.0.3",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "filesize": "11.0.17",
    "pinia": "3.0.4",
    "vue": "3.5.38"
  },
  "devDependencies": {
    "@iconify-json/fa6-brands": "1.2.6",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/simple-icons": "1.2.87",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "26.0.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rollup-plugin-visualizer": "7.0.1",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.0.16",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-inspect": "11.4.1",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5"
  }
}
