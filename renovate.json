{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "mode": "full",
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "enabledManagers": ["maven", "npm", "dockerfile", "docker-compose", "github-actions", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "**/target/**", "**/dist/**", "src/main/web/node/**"],
  "automerge": false,
  "prHourlyLimit": 10,
  "separateMajorMinor": true,
  "pruneStaleBranches": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Java libraries, Quarkus BOM and Maven plugins stay separate from frontend and images.",
      "matchManagers": ["maven"],
      "groupName": "Java dependencies",
      "additionalBranchPrefix": "java-",
      "dependencyDashboardCategory": "Java",
      "addLabels": ["java"]
    },
    {
      "description": "Frontend runtime and development dependencies.",
      "matchManagers": ["npm"],
      "groupName": "Frontend dependencies",
      "additionalBranchPrefix": "frontend-",
      "dependencyDashboardCategory": "Frontend",
      "addLabels": ["frontend"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Update Maven-managed Node and its bundled npm with the frontend dependencies.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["node"],
      "groupName": "Frontend dependencies",
      "additionalBranchPrefix": "frontend-",
      "dependencyDashboardCategory": "Frontend",
      "addLabels": ["frontend"]
    },
    {
      "description": "Keep TypeScript on 5.x until a coordinated vue-tsc and Vite migration.",
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<6"
    },
    {
      "description": "Build and runtime images, including updates behind floating tags.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker images",
      "additionalBranchPrefix": "docker-",
      "dependencyDashboardCategory": "Docker",
      "addLabels": ["docker"],
      "pinDigests": true
    },
    {
      "description": "GitHub Actions used by the development and release workflows.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "additionalBranchPrefix": "actions-",
      "dependencyDashboardCategory": "Actions",
      "addLabels": ["github-actions"]
    },
    {
      "description": "Keep the Maven builder on Java 25; JDK migrations require coordinated project/runtime changes.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["maven"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-eclipse-temurin-25$/"
    },
    {
      "description": "The Compose application image is published by this repository.",
      "matchManagers": ["docker-compose"],
      "matchDepNames": ["ghcr.io/comassky/btc-node-dashboard"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Node installation managed by Maven.",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": [
        "<quarkus\\.quinoa\\.package-manager-install\\.node-version>(?<currentValue>\\d+\\.\\d+\\.\\d+)</quarkus\\.quinoa\\.package-manager-install\\.node-version>"
      ],
      "depNameTemplate": "node",
      "packageNameTemplate": "nodejs/node",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "node"
    }
  ]
}